# Copia este archivo como .env y completa tus valores. .env no se sube a git.
# Cárgalo en la terminal con:  set -a; source .env; set +a

# LLM (opcional: vacío usa el simulador)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# Langfuse (paso 4.4)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
